class EntityAlias {
    constructor() {
        this.setupEventHandlers()
    }

    setupEventHandlers() {
        let self = this
        this.handleAddNewRow()
        this.handleReorderRowIndexes()

        const rows = $("#alias-details tbody tr")
        if (rows.length > 0) {
            $.each(rows, (i, row) => {
                self.handleNamerEntityTypeSelected($(row))
            });
        }
    }

    handleNamerEntityTypeSelected($selector) {
        let self = this
        $selector.find(".namer-entity-type").on("change", (event) => {
            // get index from row
            const index = $(event.target).closest("tr").attr("index")

            // get selected entity type
            const entityType = event.target.value

            // get entity ids dropdown
            const entityIdsDropdown = $(`#AliasableViewModel\\.AliasesViewModels\\[${index}\\]\\.NamerEntityId`)
            entityIdsDropdown.attr("disabled", false)

            $.ajax({
                dataType: 'json',
                type: 'GET',
                url: `/AliasConfig/GetAllFromNamer?namerEntityType=${entityType}`,
                success: function (result) {
                    self.fillDropdown(entityIdsDropdown, result.items)
                },
                error: function (error) {
                    swal({
                        type: 'warning',
                        text: error.responseJSON.message,
                        confirmButtonColor: '#28a745'
                    });
                }
            });
        })
    }

    handleAddNewRow() {
        let self = this
        $("#add-alias").on("click", (event) => {
            const formId = $("#alias-details").attr("form-id")
            const index = $("#alias-details tbody tr").length
            const entityType = $("#alias-details").attr("entity-type")

            $.ajax({
                dataType: 'html',
                type: 'GET',
                url: `/AliasConfig/GetNewAliasRow?index=${index}&formId=${formId}&namedEntityType=${entityType}`,
                success: function (row) {
                    $("#alias-details tbody").append(row)

                    const $row = $("#alias-details tbody tr:last")
                    self.initDropdowns($row)
                    self.handleNamerEntityTypeSelected($row)
                },
                error: function (error) {
                    swal({
                        type: 'warning',
                        text: error.responseJSON.message,
                        confirmButtonColor: '#28a745'
                    });
                }
            });
        })
    }

    handleReorderRowIndexes() {
        const formId = $("#alias-details").attr("form-id")

        $("form").submit(function (e) {
            var tableId = "#alias-details"
            var rows = $(`${tableId} tbody tr`)
            rows.each(function (index, row) {
                var inputs = $(row).find(`[form=${formId}]`)
                inputs.each(function (i, input) {
                    var id = $(input).attr("id")
                    var name = $(input).attr("name")
                    $(input).attr("id", id.replace(/\d+/, index))
                    $(input).attr("name", name.replace(/\d+/, index))
                })
            })
        })
    }

    fillDropdown($dropdown, options) {
        $dropdown.find('option').remove()

        $.each(options, function (i, option) {
            $dropdown.append($('<option>', {
                value: option.id,
                text: option.name
            }));
        });
    }

    initDropdowns($selector) {
        $selector.find('.select2').each((index, item) => {
            if ($(item).data('search-url')) {
                $(item).select2({
                    minimumInputLength: 3,
                    ajax: {
                        url: $(item).data('searchUrl')
                    }
                });
            } else {
                $(item).select2()
            }
        })
    }
}