class DxTreeListHandler {
  constructor() {}

  onDragEnd = (e) => {
    var treeList = e.component,
      visibleRows = treeList.getVisibleRows(),
      targetNode = visibleRows[e.toIndex].node;

    const nodeId = e.itemData.id;
    const newParentId = e.dropInsideItem ? targetNode.key : null;

    this.updateParent(nodeId, newParentId, e);
  };

  updateParent = (nodeId, newParentId, e) => {
    var treeList = e.component;
    const updateParentUrl = e.element.data().updateParentUrl;

    if (!updateParentUrl) {
      treeList.refresh();
      return;
    }

    const url = newParentId
      ? `${updateParentUrl}?nodeId=${nodeId}&newParentId=${newParentId}`
      : `${updateParentUrl}?nodeId=${nodeId}`;
    $.ajax({
      dataType: "json",
      type: "get",
      url: url,
      success: function () {
        treeList.refresh();
      },
    });
  };
}
