class UserClaimChangeRequest {

    constructor(configuration) {
        this.endpoint = configuration.endpoint;
        this.getTokenFunction = configuration.getTokenFunction;
        this.successCallback = configuration.successCallback;
    }

    asCallback() {
        return () => {
            $.ajax({
                dataType: 'json',
                type: 'POST',
                url: this.endpoint,
                data: {
                    "__RequestVerificationToken": this.getTokenFunction()
                },
                success: this.successCallback,
                error: function (error) {
                    swal({
                        type: 'error',
                        text: error.responseText ? error.responseText : defaultErrorMessage
                    });
                }
            });
        };
    }

}