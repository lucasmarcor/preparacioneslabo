
///<reference path="../lib/switchery/switchery.js" />
///<reference path="../lib/globalize/globalize.js" />
///<reference path="../js/devextreme/jquery.js" />
///<reference path="../js/datatable.js" />
///<reference path="../js/dropzone.js" />
///<reference path="../js/site.js" />
///<reference path="../js/charts.js" />
///<reference path="../js/maps.autocomplete.js" />
///<reference path="../js/maps.coordinates.js" />
///<reference path="../js/vimeo.player.js" />
///<reference path="../js/draganddrop.js" />
///<reference path="../js/igniteTree.js" />
///<reference path="../js/searchbox.js" />
///<reference path="../../Views/Shared/_LayoutWrapper.cshtml" />

class pluginInitializer {

	init(pluginNames, version) {
		let self = this
		this.version = version;

		this.plugins = {
			"datatable": {
				script: "/lib/datatables/datatables.min.js",
				styles: ["/lib/datatables/datatables.min.css"],
				callback: () => {
					self.document = document
					self.load("datatable-responsive")
				}
			},
			"datatable-responsive": {
				script: "/lib/datatables/datatables.responsive.min.js",
				callback: () => {
					self.load("datatable-jszip")
				}
			},
			"datatable-jszip": {
				script: "/lib/datatables/jszip.min.js",
				callback: () => {
					self.load("datatable-buttons")
				}
			},
			"datatable-buttons": {
				script: "/lib/datatables/dataTables.buttons.min.js",
				callback: () => {
					self.load("datatable-buttons-flash")
				}
			},
			"datatable-buttons-flash": {
				script: "/lib/datatables/buttons.flash.min.js",
				callback: () => {
					self.load("datatable-buttons-print")
				}
			},
			"datatable-buttons-print": {
				script: "/lib/datatables/buttons.print.min.js",
				callback: () => {
					self.load("datatable-pdf-maker")
				}
			},
			"datatable-pdf-maker": {
				script: "/lib/datatables/pdfmake.min.js",
				callback: () => {
					self.load("datatable-vfs-fonts")
				}
			},
			"datatable-vfs-fonts": {
				script: "/lib/datatables/vfs_fonts.js",
				callback: () => {
					self.load("datatable-buttons-html5")
				}
			},
			"datatable-buttons-html5": {
				script: "/lib/datatables/buttons.html5.min.js",
				callback: () => {
					self.load("datatable-columns-visibility")
				}
			},
			"datatable-columns-visibility": {
				script: "/lib/datatables/buttons.colVis.min.js",
				styles: ["/lib/datatables/buttons.datatables.min.css"],
				callback: () => {
					self.load("datatable-column-reorder")
				}
			},
			"datatable-column-reorder": {
				script: "/lib/datatables/dataTables.colReorder.min.js",
				styles: ["/lib/datatables/colReorder.dataTables.min.css"],
				callback: () => {
					self.load("datatable-initializer")
				}
			},
			"datatable-initializer": {
				script: "/js/datatable.js",
				callback: () => {
					$('.ignite-datatable').each(function () {
						var datatable = dataTableInitiator($(this));
						const deferLoading = $(this).data("deferLoading") !== undefined
						const clientSide = $(this).data("client-side") != undefined;
						const tableIdentifier = $(this).data("identifier");
						if (tableIdentifier) {
							window[tableIdentifier] = datatable;
						}
						if (!deferLoading && !clientSide) {
							datatable.ajax.reload()
						}
					})

					$('[data-filter-table-identifier]').each(function () {
						const filters = $(this).find('.filter-value')
						const tableIdentifier = $(this).data('filter-table-identifier')
						const table = window[tableIdentifier]
						const getUrl = table.ajax.url()
						const filterBtn = $(this).find('.filter-btn')

						if (filters.length === 0 || tableIdentifier.length === 0 || filterBtn.length === 0) {
							return
						}

						filterBtn.on('click', function () {
							let body = {
								data: {}
							}
							filters.each(function (index, filter) {
								const key = $(filter).attr('id')
								const value = $(filter).val()
								body.data[key] = value
							})
							const baseUrlContainsQueryParams = getUrl.indexOf("?") > -1
							const getUrlWithFilters = `${getUrl}${baseUrlContainsQueryParams ? '&' : '?'}${$.param(body)}`
							table.ajax.url(getUrlWithFilters).load()
						})

					})
				}
			},
			"select2": {
				script: "/lib/select2/select2.full.min.js",
				styles: ["/lib/select2/select2.min.css"],
				callback: () => {
					// Initialize select2
					self.load("select2-initializer")
				}
			},
			"select2-initializer": {
				script: "/js/select2.init.js",
				callback: () => {
					// Load additional logic for alma design system
					self.load("select2-alma-design-system")
				}
			},
			"select2-alma-design-system": {
				script: "/js/alma-design-system/select.js",
				styles: ["/css/alma-design-system/select.css"],
			},
			"dropzone-by-order": {
				script: "/lib/dropzone/dropzone.js",
				styles: ["/lib/dropzone/dropzone.css"],
				callback: () => {
					self.load("asset-manager-dropzone-by-order");
				}
			},
			"asset-manager-dropzone-by-order": {
				script: "/js/assetmanager.js",
				callback: () => {
					self.load("dropzone-initializer-by-order");
				}
			},
			"dropzone-initializer-by-order": {
				script: "/js/dropzoneByOrder.js",
				callback: () => {
					DropzoneFileManagerInit();
					DropzoneExcelImportInit();
				}
			},
			"dropzone": {
				script: "/lib/dropzone/dropzone.js",
				styles: ["/lib/dropzone/dropzone.css"],
				callback: () => {
					self.load("asset-manager-dropzone");
				}
			},
			"dropzone-initializer": {
				script: "/js/dropzone.js",
				callback: () => {
					DropzoneFileManagerInit();
					DropzoneExcelImportInit();
				}
			},
			"date-time-picker": {
				script: "/lib/momentjs/moment.min.js",
				callback: () => {
					self.load("date-time-picker-momentjs-dependencies")
				}
			},
			"date-time-picker-momentjs-dependencies": {
				script: "/lib/momentjs/moment-with-locales.min.js",
				callback: () => {
					self.load("date-time-picker-dependencies")
				}
			},
			"date-time-picker-dependencies": {
				script: "/lib/bootstrap-datetimepicker/bootstrap-datetimepicker.min.js",
				styles: ["/lib/bootstrap-datetimepicker/bootstrap-datetimepicker.css"],
				callback: () => {
					const customIcons = {
						previous: "fa fa-arrow-left",
						next: "fa fa-arrow-right"
					}
					// Initialize date pickers
					$('.date-picker.date-only').each(function () {

						$(this).datetimepicker({
							format: 'L',
							locale: $(this).attr("language"),
							useCurrent: false,
							minDate: $(this).attr("min") ? new Date($(this).attr("min")) : false,
							maxDate: $(this).attr("max") ? new Date($(this).attr("max")) : false,
							icons: customIcons,
							widgetPositioning: {
								vertical: 'bottom',
								horizontal: 'auto'
							}
						});
					});
					$('.date-picker.time-only').each(function () {

						$(this).datetimepicker({
							format: 'LT',
							locale: $(this).attr("language"),
							icons: customIcons,
							widgetPositioning: {
								vertical: 'bottom',
								horizontal: 'auto'
							}
						});
					});
					$('.datetime-picker').each(function () {
						$(this).datetimepicker({
							format: 'L LT',
							locale: $(this).attr("language"),
							useCurrent: false,
							minDate: $(this).attr("min") ? new Date($(this).attr("min")) : false,
							maxDate: $(this).attr("max") ? new Date($(this).attr("max")) : false,
							icons: customIcons,
							widgetPositioning: {
								vertical: 'bottom',
								horizontal: 'auto'
							}
						});
					});
					setFormInitialData();
				}
			},
			"switchery": {
				script: "/lib/switchery/switchery.min.js",
				styles: ["/lib/switchery/switchery.min.css"],
				callback: () => {
					// Init switches
					$('.js-switch').each(function () {
						new Switchery($(this)[0], $(this).data());
						this.onchange = function () {
							const hiddenInputId = `#${this.getAttribute("hidden-input-id")}`
							$(hiddenInputId)[0].value = this.checked
							!this.checked && $(hiddenInputId).removeAttr("checked")
						}
					});
				}
			},
			"chartjs": {
				script: "/lib/chartjs/Chart.min.js",
				callback: () => {
					self.load("charts-initializer")
				}
			},
			"charts-initializer": {
				script: "/js/charts.js",
				callback: () => {
					// Initialize common charts
					$(".ignite-chart").each(function () {
						let title = $(this).data("title")
						let labels = $(this).data("labels")
						let values = $(this).data("values")

						if ($(this).hasClass("line-chart")) {
							charts.newLineChart($(this), title, labels, values)
						}

						if ($(this).hasClass("bar-chart")) {
							charts.newBarChart($(this), title, labels, values)
						}

						if ($(this).hasClass("pie-chart")) {
							charts.newPieChart($(this), title, labels, values)
						}

						if ($(this).hasClass("doughnut-chart")) {
							charts.newDoughnutChart($(this), title, labels, values)
						}

						if ($(this).hasClass("polar-chart")) {
							charts.newPolarAreaChart($(this), title, labels, values)
						}

						if ($(this).hasClass("radar-chart")) {
							charts.newRadarChart($(this), title, labels, values)
						}
					})
				}
			},
			"autosize": {
				script: "/lib/autosize/autosize.min.js",
				callback: () => {
					// Autoresize textarea based on content
					autosize($('textarea.ignite-textarea'));
				}
			},
			"google-maps": {
				script: `https://maps.googleapis.com/maps/api/js?key=${googleApiKey}&libraries=places&language=${currentCulture}`,
				callback: () => {
					self.load("maps-autocomplete")
				}
			},
			"maps-autocomplete": {
				script: "/js/maps.autocomplete.js",
				callback: () => {
					self.load("google-maps-initializer")
				}
			},
			"google-maps-initializer": {
				script: "/js/maps.coordinates.js",
				callback: () => {
					// Wait until globalize is loaded
					waitUntilElementExists(Globalize, function () {
						// Initialize Google Maps Autocomplete for addresses
						$('.ignite-address').each(function () {
							const mode = $(this).data('mode')
							switch (mode) {
								case 'full': {
									const mapsAutocomplete = new MapsAutocomplete()
									mapsAutocomplete.init($(this))
									break
								}
								case 'coordinatesOnly': {
									const mapsCoordinates = new MapsCoordinates()
									mapsCoordinates.init($(this))
								}
							}
						})
					})
				}
			},
			"vimeo": {
				script: "/lib/vimeo/player.js",
				callback: () => {
					self.load("vimeo-initializer")
				}
			},
			"vimeo-initializer": {
				script: "/js/vimeo.player.js",
				callback: () => {
					// Initialize Vimeo Players
					$('.vimeo-container').each(function () {
						const vimeoPlayer = new VimeoPlayer()
						vimeoPlayer.init($(this))
					})
				}
			},
			"inputmask": {
				script: "/lib/input-mask/jquery.inputmask.bundle.js",
				callback: () => {
					self.load("inputmask-initializer")
				}
			},
			"inputmask-initializer": {
				script: "/js/mask.js",
				callback: () => {
					// Setup custom masks for inputs
					$(".custom-mask").each(function () {
						let mask = $(this).data("customMask")
						$(this).inputmask(mask)
					})
				}
			},
			"sortable": {
				script: "/lib/sortable/sortable.min.js",
				callback: () => {
					self.load("sortable-initializer")
				}
			},
			"sortable-initializer": {
				script: "/js/draganddrop.js",
				callback: () => {
					// Initialize drag and drops
					$(".dnd-container").each(function () {
						const dnd = new DragAndDrop()
						dnd.init($(this))
					})
				}
			},
			"icheck": {
				script: "/lib/icheck/icheck.min.js",
				styles: ["/lib/icheck/icheck.css", "/lib/icheck/skins/all.css"],
				callback: () => {
					self.load("icheck-initializer")
				}
			},
			"icheck-initializer": {
				script: "/js/icheck.init.js",
				callback: () => {
					$(".check").each(function () {
						$(this).on('ifChecked', function (event) {
							const $input = $(event.target);
							$input.attr("checked", "checked")
							$input.trigger('checked')
						})
						$(this).on('ifUnchecked', function (event) {
							$(event.target).removeAttr("checked")
						})
					})
				}
			},
			"tinymce": {
				script: "/lib/tinymce/tinymce.min.js",
				callback: () => {
					$(".ignite-tinymce-editor").each(function () {
						const readonly = $(this).data("readonly") === 1
						const userLang = navigator.language || navigator.userLanguage;
						const toolbar = readonly ? false : "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | print preview media fullpage | forecolor backcolor"

						tinymce.init({
							selector: `textarea#${$(this).attr("id")}.ignite-tinymce-editor`,
							theme: "modern",
							height: 300,
							plugins: [
								"advlist autolink link image lists charmap print preview hr anchor pagebreak spellchecker",
								"searchreplace wordcount visualblocks visualchars code fullscreen insertdatetime media nonbreaking",
								"save table contextmenu directionality template paste textcolor"
							],
							menubar: !readonly,
							toolbar: toolbar,
							readonly: readonly,
							body_class: readonly ? "tinymce-disabled" : "",
							content_css: "/lib/tinymce/content.css",
							language: userLang.substring(0, 2)
						});
					})
				}
			},
			"nestable": {
				script: "/lib/nestable/jquery.nestable.js",
				styles: ["/lib/nestable/nestable.css"],
				callback: () => {
					self.load("nestable-initializer")
				}
			},
			"nestable-initializer": {
				script: "/js/igniteTree.js",
				callback: () => {
					$(".ignite-tree").each(function () {
						const tree = new IgniteTree()
						tree.init($(this))
					})
				}
			},
			"carousel": {
				script: "/lib/owl-carousel/owl.carousel.min.js",
				styles: ["/lib/owl-carousel/owl.carousel.min.css"],
				callback: () => {
					$(".owl-carousel").each(function () {
						const carousel = $(this)
						const items = carousel.find(".custom_overlay_wrapper").length
						carousel
							.on({
								'initialized.owl.carousel': function () {
									carousel.removeClass("invisible")
								}
							})
							.owlCarousel({
								items: 4,
								loop: items >= 3,
								margin: 10,
								lazyLoad: false,
								autoplay: true,
								autoplayTimeout: 3000,
								autoplayHoverPause: true,
								smartSpeed: 1500
							})
					})
				}
			},
			"uppy": {
				script: "/lib/uppy/uppy.min.js",
				styles: ["/lib/uppy/uppy.min.css"],
				callback: () => {
					self.load("asset-manager-uppy");
				}
			},
			"uppy-initializer": {
				script: "/js/uppy.js",
				callback: () => {
					UppyInit();
				}
			},
			"asset-manager-dropzone": {
				script: "/js/assetmanager.js",
				callback: () => {
					self.load("dropzone-initializer");
				}
			},
			"asset-manager-uppy": {
				script: "/js/assetmanager.js",
				callback: () => {
					self.load("uppy-initializer");
				}
			},
			"asset-manager": {
				script: "/js/assetmanager.js"
			},
			"light-gallery": {
				script: "/lib/lightgallery/src/js/lightgallery.js",
				styles: ["/lib/lightgallery/src/css/lightgallery.css"],
				callback: () => {
					// Plugins
					self.load("light-gallery-autoplay");
					self.load("light-gallery-fullscreen");
					self.load("light-gallery-thumbnail");
					self.load("light-gallery-zoom");
					
					self.load("light-gallery-initializer");
				}
			},
			"light-gallery-initializer": {
				script: "/js/light-gallery.js",
				callback: () => {
					$('.ignite-gallery').each(function () {
						$(this).on('click', function() {
                            const gallery = new LightGallery($(this));
                            gallery.open();
                        });
                    });
                }
            },
            "light-gallery-autoplay": {
                script: "/lib/lightgallery/modules/lg-autoplay.min.js"
            },
            "light-gallery-fullscreen": {
                script: "/lib/lightgallery/modules/lg-fullscreen.min.js"
            },
            "light-gallery-thumbnail": {
                script: "/lib/lightgallery/modules/lg-thumbnail.min.js"
            },
            "light-gallery-zoom": {
                script: "/lib/lightgallery/modules/lg-zoom.min.js"
            },
            "simple-file-upload": {
                script: "/js/simpleFileUpload.js",
                styles: ["/css/simpleFileUpload.css"]
            },
            "croppie": {
                script: "/lib/croppie/croppie.min.js",
                styles: ["/lib/croppie/croppie.min.css"],
                callback: () => {
                    self.load("croppie-initializer")
                }
            },
            "croppie-initializer": {
                script: "/js/croppie.js"
            },
            "searchbox": {
                script: "/js/searchbox.js",
                callback: () => {                    
                    $(".searchbox").each(function () {                        
                        const searchBox = new SearchBox();
                        searchBox.init($(this))
                    })
                }
            },
        }
        pluginNames = pluginNames.replace(/\s/g, '');
        pluginNames = pluginNames.split(",")
        for (const pluginName of pluginNames) {
            this.load(pluginName)
        }

		setTimeout(() => document.dispatchEvent(new Event('loaded.ignite-plugins')), 1000);
    }

	appendStyles(src) {
		var link = document.createElement('link');
		link.setAttribute('rel', 'stylesheet');
		link.setAttribute('type', 'text/css');
		link.setAttribute('href', this.appendVersion(src));
		const customCss = document.getElementById("custom-css-link");
		document.getElementsByTagName('head')[0].insertBefore(link, customCss);
	}

	appendScript(src, callback) {
		var s = document.createElement('script');
		s.setAttribute('src', this.appendVersion(src));

		if (callback) {
			s.onload = callback;
		}
		document.body.appendChild(s);
	}

	load(pluginName) {
		const plugin = this.plugins[pluginName]
		// Load css's
		if (plugin.styles && plugin.styles.length > 0) {
			for (const style of plugin.styles) {
				this.appendStyles(style)
			}
		}
		// Load script
		if (plugin.script) {

			this.appendScript(plugin.script, plugin.callback || null)
		}
	}

	/** 
	 * @private 
	 * Adds the current version as a query param to the script/css uri 
	 * @param {String} uri Script/Css URI
	 * @returns {String}
	 */
	appendVersion(uri) {
		const versionParam = `v=${this.version}`;
		let uriWithVersion = '';

		if (uri.indexOf('?') >= 0)
			uriWithVersion += `${uri}&${versionParam}`;
		else
			uriWithVersion += `${uri}?${versionParam}`;

		return uriWithVersion;
	}

}